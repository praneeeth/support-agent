DATABASE_URL=sqlite:///./support.db
STAFF_USERNAME=staff
STAFF_PASSWORD=change-me
# --- Model provider -------------------------------------------------------
# Free + local (default): run `ollama serve` and `ollama pull qwen3:8b`
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=

# Free hosted alternatives (same provider setting, just different values):
#   Groq:            LLM_BASE_URL=https://api.groq.com/openai/v1           LLM_API_KEY=gsk_...
#   Google AI Studio: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:      LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_API_KEY=sk-or-...
#
# Paid Anthropic API instead:
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Business ---------------------------------------------------------------
# Which folder under verticals/ this deployment serves.
VERTICAL=northwind
# Public calendar links for check_availability (Airbnb/Booking.com/Vrbo), comma-separated.
ICAL_URLS=

# --- Widget appearance ----------------------------------------------------
# Brand, tagline, greeting, accent and suggestions come from the vertical's `widget:` block.
# Set any of these only to override it for this deployment.
WIDGET_BRAND=
WIDGET_TAGLINE=
WIDGET_GREETING=
WIDGET_ACCENT=
WIDGET_LOGO_URL=
WIDGET_POSITION=right
WIDGET_THEME=auto
# Opening chips, pipe-separated (a question may contain a comma).
WIDGET_SUGGESTIONS=

# Sample credentials shown on /chat/demo so a prospect can see a real order card.
# Leave empty in production.
DEMO_ORDER_NUMBER=
DEMO_ORDER_EMAIL=
